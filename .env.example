PORT=3000
SESSION_SECRET=troque-este-segredo-por-uma-frase-longa-e-aleatoria
RESTAURANT_NAME=Restaurante SLEY
BASE_URL=http://localhost:3000
CODIGO_MESA_ATIVO=true
TZ=Africa/Maputo

# PostgreSQL / Supabase (obrigatório).
# Copie a connection string em Supabase > Project Settings > Database.
# Formato (substituir todos os campos por valores reais):
# DATABASE_URL=postgresql://UTILIZADOR:PALAVRA_PASSE@HOST:5432/BASE_DE_DADOS
DATABASE_URL=
# SSL ativo por omissão (rejectUnauthorized=false para os poolers do Supabase).
# Use DATABASE_SSL=false apenas num Postgres local sem SSL.
DATABASE_SSL=true

UPLOAD_MAX_MB=5
VIDEO_MAX_MB=5
VIDEO_MAX_SEGUNDOS=15

# Supabase Storage (opcional).
# Sem SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY, os ficheiros ficam guardados
# localmente em public/uploads. A service_role key nunca é enviada ao browser:
# só o servidor Express a usa para enviar/apagar ficheiros.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Buckets com leitura pública e escrita apenas para administradores.
# SUPABASE_BUCKET_FOTOS=pratos
# SUPABASE_BUCKET_VIDEOS=videos-pratos
