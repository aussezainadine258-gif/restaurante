<%- include('../partials/head', { cssExtra: '/css/admin.css' }) %>
<body class="pagina-auth">
  <main class="auth-wrap auth-wrap--simples">
    <section class="auth-lado auth-lado--compacto">
      <div class="auth-marca">
        <span class="marca-logo" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="30" height="30">
            <path d="M21 14v15a5 5 0 0 0 10 0V14" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round"/>
            <path d="M26 14v36" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round"/>
            <path d="M43 50V14c6 2 8 8 8 14s-3 9-8 9" fill="none" stroke="#111111" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <div>
          <strong><%= restaurante %></strong>
          <span><%= utilizador.papel === 'admin' ? 'Gerência' : 'Cozinha' %></span>
        </div>
      </div>
      <div class="auth-discurso">
        <p class="eyebrow eyebrow--laranja">Segurança</p>
        <h1>Uma password <span>só sua.</span></h1>
        <p>Defina uma password forte para proteger o acesso ao painel e à operação do restaurante.</p>
      </div>
      <p class="auth-assinatura"><%= utilizador.nome %> · <%= utilizador.username %></p>
    </section>

    <section class="auth-painel">
      <div class="auth-card">
        <p class="eyebrow">Conta</p>
        <h2>Alterar password</h2>
        <% if (utilizador.deve_alterar_password) { %>
          <div class="alerta alerta--ok" role="status">Está a usar uma password inicial. Altere-a para continuar.</div>
        <% } %>
        <p class="auth-intro">Use pelo menos 8 caracteres. Evite nomes óbvios ou dados pessoais.</p>

        <% if (erro) { %>
          <div class="alerta alerta--erro" role="alert"><%= erro %></div>
        <% } %>
        <% if (flash) { %>
          <div class="alerta alerta--<%= flash.tipo === 'sucesso' ? 'ok' : 'erro' %>" role="status"><%= flash.mensagem %></div>
        <% } %>

        <form action="/admin/password" method="post" class="auth-form" autocomplete="off">
          <div>
            <label class="campo" for="password_atual">Password atual</label>
            <input class="input" id="password_atual" name="password_atual" type="password" autocomplete="current-password" required>
          </div>
          <div>
            <label class="campo" for="password_nova">Nova password</label>
            <input class="input" id="password_nova" name="password_nova" type="password" autocomplete="new-password" minlength="8" maxlength="72" required>
          </div>
          <div>
            <label class="campo" for="password_confirmar">Confirmar nova password</label>
            <input class="input" id="password_confirmar" name="password_confirmar" type="password" autocomplete="new-password" minlength="8" maxlength="72" required>
          </div>
          <button type="submit" class="btn btn-laranja btn-bloco btn-grande">Guardar nova password</button>
        </form>

        <div class="auth-rodape">
          <form action="/admin/logout" method="post">
            <button type="submit" class="link-botao">Terminar sessão</button>
          </form>
          <span><%= utilizador.username %></span>
        </div>
      </div>
    </section>
  </main>
</body>
</html>
