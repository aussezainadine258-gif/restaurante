<%- include('partials/head') %>
<body class="pagina-estado" data-mesa="<%= mesa.numero %>">
  <main class="estado-fundo">
    <div class="estado-card">
      <div class="estado-mesa">Mesa <strong><%= mesa.numero %></strong></div>
      <div class="estado-icone" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 15v2"/></svg>
      </div>
      <h1>A mesa ainda não está ativa</h1>
      <p>Peça ao empregado para ativar a mesa. Assim que estiver pronta, o menu abre automaticamente.</p>
      <a href="/menu?mesa=<%= mesa.numero %>" class="btn btn-laranja btn-bloco btn-grande">Já ativaram a mesa</a>
      <p class="estado-dica" id="estado-dica"><span class="spinner spinner--pequeno" aria-hidden="true"></span> A verificar automaticamente…</p>
    </div>
    <p class="estado-marca"><%= restaurante %></p>
  </main>
  <script src="/js/mesa-inativa.js" defer></script>
</body>
</html>
